{
  "name": "pi-dictation",
  "version": "0.6.0",
  "description": "Safe push-to-talk dictation for Pi with pluggable transcription backends",
  "type": "module",
  "license": "MIT",
  "author": "Yasuhito Takamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasuhito/pi-dictation.git"
  },
  "homepage": "https://github.com/yasuhito/pi-dictation#readme",
  "bugs": {
    "url": "https://github.com/yasuhito/pi-dictation/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "dictation",
    "speech-to-text",
    "voice-input",
    "linux",
    "macos"
  ],
  "bin": {
    "pi-dictation": "bin/pi-dictation.mjs",
    "pi-dictation-bridge-certify": "bin/pi-dictation-bridge-certify.cjs",
    "pi-dictation-doctor": "bin/pi-dictation-doctor.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "native",
    "docs/bridge-recording-support.md",
    "docs/certification/*.md",
    "pi-dictation.schema.json",
    "pi-dictation.example.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "test:native-bridge-adversarial": "scripts/run-native-bridge-adversarial.sh",
    "test:native-bridge-lifecycle": "scripts/run-native-bridge-lifecycle.sh",
    "typecheck": "tsc --noEmit",
    "test:assertions": "node scripts/check-test-assertions.mjs",
    "check": "npm run test:assertions && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "doctor": "node bin/pi-dictation-doctor.mjs",
    "demo:generate": "node scripts/generate-demo.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-dictation.ts"
    ],
    "video": "https://raw.githubusercontent.com/yasuhito/pi-dictation/main/assets/pi-dictation-demo.mp4",
    "image": "https://raw.githubusercontent.com/yasuhito/pi-dictation/main/assets/pi-dictation-demo.gif"
  },
  "dependencies": {
    "cli-spinners": "^3.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jiti": "^2.6.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
